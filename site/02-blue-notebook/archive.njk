permalink: 02-blue-notebook/archive.html
title: Archive
description: Every published entry from The Blue Notebook.
current: archive
---
<article class="archive-page">
  <h1>Archive</h1>
  <p class="lede">Every notebook entry, newest first.</p>
</article>

<div class="entry-list archive-list">
  {% for post in collections.posts %}
    <article class="entry-overview">
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      <div>
        <h2><a href="{{ post | postUrl(sites.notebook.path) | url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description }}</p>
      </div>
    </article>
  {% endfor %}
</div>
