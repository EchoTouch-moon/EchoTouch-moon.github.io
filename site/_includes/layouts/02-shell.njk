<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }} — {{ sites.notebook.name }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or sites.notebook.description }}">
  <meta property="og:title" content="{{ title }} — {{ sites.notebook.name }}">
  <meta property="og:description" content="{{ description or sites.notebook.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='46' fill='%231b3156'/><circle cx='50' cy='50' r='42' fill='none' stroke='%23dbe6f2' stroke-width='3'/><text x='50' y='63' text-anchor='middle' font-size='42' font-family='Georgia,serif' font-weight='bold' fill='%23ffffff'>ET</text></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400&family=Merriweather:wght@400;700&family=Ubuntu+Mono:wght@400&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ ('/' ~ sites.notebook.path ~ '/assets/style.css?v=8') | url }}">

  <script>
    (function () {
      try {
        var t = localStorage.getItem("notebook-theme");
        if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
      } catch (e) { /* private mode */ }
      document.documentElement.setAttribute("data-initial-load", "true");
    })();
  </script>

  <script type="speculationrules">
    { "prefetch": [ { "where": { "href_matches": "{{ ('/' ~ sites.notebook.path ~ '/*') | url }}" }, "eagerness": "moderate" } ] }
  </script>

  <script src="{{ ('/' ~ sites.notebook.path ~ '/assets/app.js?v=4') | url }}" defer></script>
  <script src="{{ ('/' ~ sites.notebook.path ~ '/assets/tide.js?v=5') | url }}" defer></script>
</head>
<body>
  <div class="band band-top" aria-hidden="true">
    <canvas class="tide-canvas" data-flip="false"></canvas>
  </div>

  <div class="container">
    <header class="masthead">
      <span class="avatar-ring"><span class="monogram">bn.</span></span>
      <a href="{{ ('/' ~ sites.notebook.path ~ '/') | url }}">{{ sites.notebook.name }}</a>
    </header>

    <nav class="navigation" aria-label="primary">
      <a href="{{ ('/' ~ sites.notebook.path ~ '/') | url }}"{% if current == 'blog' %} aria-current="page"{% endif %}>blog</a>
      <a href="{{ ('/' ~ sites.notebook.path ~ '/archive.html') | url }}"{% if current == 'archive' %} aria-current="page"{% endif %}>archive</a>
      <a href="{{ ('/' ~ sites.notebook.path ~ '/about.html') | url }}"{% if current == 'about' %} aria-current="page"{% endif %}>about</a>
    </nav>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site">
      <p>&copy; 2026 {{ sites.notebook.copyright }} · content licensed CC&nbsp;BY-NC&nbsp;4.0</p>
      <p>your local time: <span id="local-time">—</span> · <span id="greeting"></span>
        <noscript>· greetings, wherever and whenever you are</noscript></p>
      <p>
        Color scheme:
        <span id="theme-form" class="theme-form">
          <label><input type="radio" name="theme" value="system"> <span>auto</span></label>,
          <label><input type="radio" name="theme" value="light"> <span>light</span></label>,
          <label><input type="radio" name="theme" value="dark"> <span>dark</span></label>.
        </span>
      </p>
    </footer>
  </div>

  <div class="band band-bottom" aria-hidden="true">
    <canvas class="tide-canvas" data-flip="true"></canvas>
  </div>

  <button class="to-top" aria-label="back to top" type="button">↑</button>
</body>
</html>
