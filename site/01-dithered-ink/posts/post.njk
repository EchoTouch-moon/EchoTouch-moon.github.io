---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "posts/{{ post.data.slug }}/index.html"
layout: layouts/01-shell.njk
eleventyComputed:
  title: "{{ post.data.title }}"
  description: "{{ post.data.description }}"
  ogType: article
---
{% set older = collections.posts | olderPost(post) %}
{% set newer = collections.posts | newerPost(post) %}
<article itemscope itemtype="https://schema.org/BlogPosting">
  <p class="post-date" data-date="{{ post.date | htmlDateString }}">
    {{ post.date | readableDate }}{% if post.data.category %} · <span class="category-badge">{{ post.data.category }}</span>{% endif %}
  </p>
  <h1 itemprop="headline">{{ post.data.title }}</h1>
  <p class="lede">{{ post.data.lede | safe }}</p>

  <div itemprop="articleBody">
    {{ post.templateContent | safe }}
  </div>

  {% if post.data.tags and post.data.tags.length %}
    <div class="tags" aria-label="tags">
      {% for tag in post.data.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
    </div>
  {% endif %}

  {% if older or newer %}
    <nav class="post-nav" aria-label="More entries">
      {% if older %}<a rel="prev" href="{{ older | postUrl(sites.ink.path) | url }}">← {{ older.data.title }}</a>{% endif %}
      {% if newer %}<a rel="next" href="{{ newer | postUrl(sites.ink.path) | url }}">{{ newer.data.title }} →</a>{% endif %}
    </nav>
  {% endif %}
</article>

<p class="backlink"><a href="{{ (sites.ink.path | sitePath) | url }}">← back to entries</a></p>
