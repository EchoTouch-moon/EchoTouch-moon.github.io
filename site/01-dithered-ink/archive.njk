---
layout: layouts/01-shell.njk
permalink: archive.html
title: Archive
description: All entries in chronological order.
current: archive
---
<h1 class="page-title">Archive</h1>

<div class="entry-list">
  {% for post in collections.posts %}
    <article class="entry">
      <h2><a href="{{ post | postUrl(sites.ink.path) | url }}">{{ post.data.title }}</a></h2>
      <p class="summary">{{ post.data.lede }}</p>
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    </article>
  {% endfor %}
</div>

<p class="backlink"><a href="{{ (sites.ink.path | sitePath) | url }}">← back to entries</a></p>
